{
  "name": "passwordthing",
  "version": "0.1.1",
  "description": "A modular, privacy-first TypeScript library for frontend password and authentication flows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arnonsang/passwordthing"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.cjs"
    },
    "./strength": {
      "types": "./dist/strength/index.d.ts",
      "import": "./dist/strength/index.mjs",
      "require": "./dist/strength/index.cjs"
    },
    "./breach": {
      "types": "./dist/breach/index.d.ts",
      "import": "./dist/breach/index.mjs",
      "require": "./dist/breach/index.cjs"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.mjs",
      "require": "./dist/crypto/index.cjs"
    },
    "./passkey": {
      "types": "./dist/passkey/index.d.ts",
      "import": "./dist/passkey/index.mjs",
      "require": "./dist/passkey/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:bloom": "bun run scripts/build-bloom.ts",
    "test": "vitest run",
    "test:integration": "node tests/integration/integration.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "fast-check": "^3.0.0",
    "generate-password": "^1.7.1",
    "happy-dom": "^17.0.0",
    "msw": "^2.0.0",
    "password-validator": "^5.3.0",
    "react": "^19.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.8.0",
    "unrun": "^0.3.0",
    "vitest": "^3.0.0",
    "zxcvbn": "^4.4.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
